# Nama aplikasi yang tampil di judul tab & header
VITE_APP_NAME="Bank Provita"
# Origin API Laravel (satu domain induk dengan aplikasi ini, mis. https://api.<domain>).
# Kosongkan bila memakai proxy Vite (npm run dev:api) atau API satu origin.
VITE_API_URL=http://localhost:8000
# Prefix endpoint nasabah (CSRF cookie Sanctum tetap di root /sanctum/csrf-cookie)
VITE_API_PREFIX=/api/v1
# Target proxy dev server untuk /api & /sanctum (hanya npm run dev:api)
VITE_PROXY_TARGET=http://127.0.0.1:8000
# true = memakai Mock Service Worker (data contoh), false = API sungguhan
VITE_USE_MOCK=true
